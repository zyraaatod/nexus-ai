# NVIDIA API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_PROVIDER=nvidia

# Alternative: OpenAI-compatible (if using different provider)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=nexus-ai-cybersec-2024-change-in-production
SESSION_TIMEOUT=3600

# Shell/Terminal Configuration
SHELL_TIMEOUT=300
MAX_COMMAND_OUTPUT=50000
ALLOWED_COMMANDS=nmap,masscan,nikto,sqlmap,ffuf,gobuster,dirb,whatweb,wafw00f,subfinder,amass,assetfinder,httpx,nuclei,dalfox,xsstrike,commix,ssh-audit,testssl.sh,lnmap,enum4linux,smbclient,ldapsearch,dig,host,nslookup,whois,curl,wget,python3,perl,ruby,node,php,bash,sh,zsh,fish,tmux,screen,git,jq,awk,sed,grep,ripgrep,fd,fzf,bat,exa,lsd,dust,duf,procs,htop,btop,glances,netstat,ss,lsof,ps,top,free,df,mount,lsblk,fdisk,parted,mkfs,fsck,dd,nc,ncat,socat,openssl,gpg,age,sops,vault,aws,azure,gcloud,terraform,ansible,kubectl,helm,argocd,flux,kustomize,k9s,stern,kubectx,kubens,velero,istioctl,linkerd,cilium,calico,flannel,weave,multus,whereabouts,host-local,portmap,bandwidth,firewall,sriov,host-device,bridge,macvlan,ipvlan,vlan,ptp,bridge,host-device,ipvlan,macvlan,vlan,ptp

